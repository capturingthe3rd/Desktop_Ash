{
  "name": "desktop_ash",
  "version": "0.1.0",
  "description": "Standalone Electron pet overlay driven by localhost state pushes",
  "main": "dist/main/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && ELECTRON_RUN_AS_NODE= electron .",
    "launch": "ELECTRON_RUN_AS_NODE= electron .",
    "dev": "concurrently \"tsc -p tsconfig.main.json --watch\" \"vite\"",
    "dist": "npm run build && electron-builder --mac --publish=never",
    "release": "npm run build && electron-builder --mac --publish=always",
    "stress:activity-log": "node scripts/stress-activity-log.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/node": "^25.6.0",
    "concurrently": "^9.1.2",
    "electron": "^42.0.0",
    "electron-builder": "^25.1.8",
    "husky": "^9.1.7",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.3"
  }
}
